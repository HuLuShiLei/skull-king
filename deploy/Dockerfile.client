# 前端镜像：nginx 托管静态产物。后端地址不写死在构建里，
# 而是容器启动时由 entrypoint 注入，所以同一个镜像能连不同环境的后端。
#   docker build -f deploy/Dockerfile.client -t skullking-client .

FROM node:22-alpine AS build
WORKDIR /src

COPY client/package.json client/package-lock.json ./
RUN npm ci

COPY client ./

# 覆盖默认的 outDir（默认是产给后端 wwwroot 的单体部署用的）。
ENV SKULLKING_OUT_DIR=dist
RUN npm run build

FROM nginx:1.27-alpine

COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY deploy/entrypoint.client.sh /docker-entrypoint.d/40-skullking-config.sh
COPY --from=build /src/dist /usr/share/nginx/html

# 空表示同源：反代把 /api 和 /hub 分流到后端时用这种，前端不跨域。
# 前后端分成两个域名时填后端外部地址，例如 https://sk-api.example.com
ENV SKULLKING_API_BASE=""

RUN chmod +x /docker-entrypoint.d/40-skullking-config.sh

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1/ || exit 1
