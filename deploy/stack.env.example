# 按所选 Compose 文件填写。使用 *.build.yml 时可不设 IMAGE_OWNER、IMAGE_TAG。
# 「Traefik 同机」与「Traefik 跨主机」两组不要混用。

# Traefik 同机（stack.traefik*.yml）时必填；跨主机时域名写在 Traefik 配置中。
SKULLKING_DOMAIN=sk.example.com

# GHCR 命名空间：GitHub 用户或组织名，必须小写。
IMAGE_OWNER=hulushilei

# 镜像标签。留空或 latest 跟踪默认分支构建。
IMAGE_TAG=latest

# ── 仅 Traefik 同机 ──
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# ── 仅 Traefik 跨主机 ──
# 绑定本机内网 IP。不要使用 0.0.0.0，以免在公网网卡上监听。
BIND_ADDR=192.168.66.20
SERVER_PORT=8080
WEB_PORT=8081

TZ=Asia/Shanghai

# 同源反代留空。前后端分域名时填后端对外 URL，例如 https://sk-api.example.com，
# 并在 server 上设置 Cors__AllowedOrigins=https://sk.example.com
SKULLKING_API_BASE=
