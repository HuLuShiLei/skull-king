# Portainer 部署时把这些填到 Stack 的 Environment variables 里。
# 用 stack.traefik.build.yml（服务器现场构建）时，IMAGE_OWNER 和 IMAGE_TAG 可以不填。

# 对外域名，DNS 要先解析到这台服务器
SKULLKING_DOMAIN=sk.example.com

# GHCR 上的镜像归属者，就是 GitHub 用户名，必须全小写
IMAGE_OWNER=stoneshilei

# 想固定版本就填 v1.0.0 之类的标签，留空默认 latest
IMAGE_TAG=latest

# Traefik 相关：按你现有 Traefik 的实际配置改
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

TZ=Asia/Shanghai

# 同源部署（推荐）留空。
# 只有把前后端拆成两个域名时才填后端外部地址，例如 https://sk-api.example.com，
# 并且要给 server 服务加上 Cors__AllowedOrigins=https://sk.example.com
SKULLKING_API_BASE=
