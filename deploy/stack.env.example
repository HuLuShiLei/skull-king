# Portainer 部署时把这些填到 Stack 的 Environment variables 里。
# 用 *.build.yml（现场构建）时，IMAGE_OWNER 和 IMAGE_TAG 可以不填。
#
# 下半部分「Traefik 同机」和「Traefik 在别的机器」是二选一的，
# 用哪个 stack 文件就填哪一组，另一组不用管。

# 对外域名，DNS 要先解析到 Traefik 那台机器。
# 注意：只有 Traefik 同机（stack.traefik*.yml）时才需要，
# 跨主机时域名写在 Traefik 自己的配置文件里。
SKULLKING_DOMAIN=sk.example.com

# GHCR 上的镜像归属者，就是 GitHub 用户名，必须全小写
IMAGE_OWNER=hulushilei

# 想固定版本就填 v1.0.0 之类的标签，留空默认 latest
IMAGE_TAG=latest

# ── 仅「Traefik 同机」需要，按你现有 Traefik 的实际配置改 ──
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# ── 仅「Traefik 在别的机器」需要 ──
# 必须填本机内网 IP，不能留 0.0.0.0，否则这两个端口会挂到公网网卡上
BIND_ADDR=192.168.66.20
SERVER_PORT=8080
WEB_PORT=8081

TZ=Asia/Shanghai

# 同源部署（推荐）留空。
# 只有把前后端拆成两个域名时才填后端外部地址，例如 https://sk-api.example.com，
# 并且要给 server 服务加上 Cors__AllowedOrigins=https://sk.example.com
SKULLKING_API_BASE=
